# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# MySQL (relational data: users, artists, bookings, reviews)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=booking_api

# MongoDB (document data: artist profiles)
MONGO_URI=mongodb://localhost:27017/booking_api
